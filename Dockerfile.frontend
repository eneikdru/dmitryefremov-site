FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN echo '<!DOCTYPE html><html><head><title>Dmitry Efremov</title></head><body><h1>Dmitry Efremov</h1><p>Systems, logic, and autonomous processes.</p></body></html>' > /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
